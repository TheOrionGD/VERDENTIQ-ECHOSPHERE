{
  "name": "verdantiq-ecosphere",
  "version": "1.0.6",
  "description": "VerdantIQ Ecosphere Desktop Software",
  "author": {
    "name": "VerdantIQ Ecosphere",
    "email": "support@verdantiq.org"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:contrast": "node scripts/contrast_audit.js",
    "clean": "next clean",
    "seed": "node scripts/seed_database.js",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron:build": "cross-env WIN_CSC_LINK=certs/verdantiq-signing.pfx WIN_CSC_KEY_PASSWORD=VerdantIQ2026! electron-builder --win",
    "desktop:dev": "npm run electron",
    "desktop:build": "npm run electron:build",
    "android:sync": "cap sync android",
    "android:build": "cap sync android && cd android && gradlew.bat assembleDebug",
    "android:build:release": "cap sync android && cd android && gradlew.bat assembleRelease",
    "android:open": "cap open android"
  },
  "build": {
    "appId": "com.verdantiq.ecosphere",
    "productName": "VerdantIQ",
    "copyright": "Copyright © 2026 VerdantIQ Ecosphere",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "cscLink": "certs/verdantiq-signing.pfx",
      "cscKeyPassword": "${env.WIN_CSC_KEY_PASSWORD:-VerdantIQ2026!}",
      "signtoolOptions": {
        "publisherName": "VerdantIQ"
      },
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "multiLanguageInstaller": false,
      "license": "build/license.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VerdantIQ",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.21.0",
    "groq-sdk": "^1.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "mongodb": "^7.5.0",
    "motion": "^12.4.7",
    "next": "^15.1.7",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.174.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/canvas-confetti": "^1.9.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  }
}

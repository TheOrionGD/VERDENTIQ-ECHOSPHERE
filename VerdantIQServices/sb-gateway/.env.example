# Gateway & ML Backend Microservice Base URLs
NEXT_PUBLIC_GATEWAY_URL="https://verdantiq-sb-gateway.onrender.com"
ML_SERVICE_URL="https://verdantiq-ml-gateway.onrender.com"

# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="your_gemini_api_key_here"

# GROQ_API_KEY: Required for Groq AI API calls
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://verdantiq-client.onrender.com"

# Enable or disable the floating Dev Role Switcher overlay ('true' or 'false')
NEXT_PUBLIC_ENABLE_DEV_ROLE_SWITCHER="true"

# MongoDB Database Configuration
MONGODB_URI="mongodb://username:password@cluster.mongodb.net/?ssl=true"
MONGODB_DB_NAME="VerdantIQ"

# Internal service-to-service authentication secret
INTERNAL_SERVICE_KEY="your_internal_service_key_here"

# Firebase Authentication Configuration
FIREBASE_CREDENTIALS_PATH=firebase-admin-key.json
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain_here"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_firebase_project_id_here"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket_here"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_firebase_sender_id_here"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id_here"

# Brevo Transactional Email & OTP Verification API Key
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="noreply@verdantiq.org"
BREVO_SENDER_NAME="VerdantIQ Verification System"
